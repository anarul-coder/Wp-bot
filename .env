# Copy this file to .env for local use. Do not upload .env to GitHub.
# Use digits with country code, no +, spaces, or punctuation. Example format only:
ALLOWED_PHONE_NUMBER=8801346498005

# OpenRouter key created at https://openrouter.ai/keys
OPENROUTER_API_KEY=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
OPENROUTER_MODEL=openrouter/free

# Use the same long random secret in Python and Node bridge.
BRIDGE_SECRET=replace_with_a_long_random_secret
WHATSAPP_BRIDGE_URL=http://localhost:3001
PYTHON_APP_URL=http://localhost:10000

# Render service URL, if desired
PUBLIC_APP_URL=https://your-dashboard.onrender.com

# Persistent session folder for the Node bridge
AUTH_DIR=./auth_info
